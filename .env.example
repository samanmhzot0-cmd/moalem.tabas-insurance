NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://YOUR-DOMAIN.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/maallem_insurance
DATABASE_SSL=true
DB_POOL_MAX=20
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
COOKIE_SECURE=true
MAX_PHOTOS=6
MAX_PHOTO_MB=12

# Optional but recommended for 200+ concurrent users:
REDIS_URL=redis://USER:PASSWORD@HOST:6379
PHOTO_WORKER_CONCURRENCY=2

# Optional private S3-compatible Object Storage:
S3_ENDPOINT=https://YOUR-S3-ENDPOINT
S3_REGION=auto
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=YOUR_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET
S3_FORCE_PATH_STYLE=false
